# NextAuth
# BẮT BUỘC đổi thành chuỗi ngẫu nhiên riêng: openssl rand -base64 32
NEXTAUTH_SECRET=placeholder
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (đăng nhập bằng Gmail)
# Tạo tại: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google        (local)
#   https://<domain>/api/auth/callback/google             (production)
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Upstash Redis (allowlist người dùng, chat history, cache)
KV_REST_API_URL=placeholder
KV_REST_API_TOKEN=placeholder

# Claude API
ANTHROPIC_API_KEY=placeholder
# Model dùng cho toàn bộ chức năng (hỏi-đáp, kiểm tra hồ sơ, bản tin)
VSEC_DEFAULT_MODEL=claude-sonnet-5
VSEC_COMPARE_MODEL=claude-sonnet-5

# Chế độ đối chiếu Việt–quốc tế đang TẮT (corpus chưa có NFPA/ISO/EN).
# Đặt =1 để bật lại, kèm bỏ comment mục intl_compare trong ChatPanel.js
VSEC_ENABLE_INTL_COMPARE=0

# Google Embedding (gemini-embedding-001, song ngữ vi/en)
# VSEC_EMBED_DIM phải BẰNG dimension của Upstash Vector index.
# Số chiều khác 3072 sẽ được tự chuẩn hoá L2 (model chỉ chuẩn hoá sẵn bản 3072).
VSEC_EMBED_DIM=1536
GOOGLE_API_KEY=placeholder

# Upstash Vector — dimension PHẢI khớp VSEC_EMBED_DIM, metric=cosine
# Gói free Upstash tối đa 1536 chiều. gemini-embedding-001 dùng Matryoshka nên
# 1536 có điểm MTEB ngang 3072 (68,17) — cắt bớt gần như không mất chất lượng.
UPSTASH_VECTOR_REST_URL=placeholder
UPSTASH_VECTOR_REST_TOKEN=placeholder

# Supabase (logging, user profiles, token quota)
NEXT_PUBLIC_SUPABASE_URL=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder

# GitHub (chức năng upload văn bản: commit file .md vào raw/ để chạy pipeline)
GITHUB_TOKEN=placeholder
GITHUB_REPO=vsec2025/vietsafe-standards

# App tuning
VSEC_TOP_K=8
VSEC_HYBRID_ALPHA=0.5

# Kiểm tra dự án tạm tắt (server + client). Đặt =1 ở CẢ HAI để bật lại.
VSEC_ENABLE_PROJECT=0
NEXT_PUBLIC_ENABLE_PROJECT=0

# Hạn mức embed của Google (free tier: 100 văn bản/phút). Giảm nếu vẫn bị 429.
VSEC_EMBED_RPM=90
